{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    {
      "source": "/vadrozsa",
      "destination": "https://vadrozsa.vercel.app/"
    },
    {
      "source": "/vadrozsa/:path*",
      "destination": "https://vadrozsa.vercel.app/:path*"
    },
    { 
      "source": "/(.*)", 
      "destination": "/api/ssr" 
    }
  ]
}
